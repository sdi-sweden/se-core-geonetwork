<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <skos:ConceptScheme xmlns:skos="http://www.w3.org/2004/02/skos/core#" rdf:about="http://inspire.ec.europa.eu/metadata-codelist/IACSData">
    <dc:title xmlns:dc="http://purl.org/dc/elements/1.1/" xml:lang="sv">Uppgifter från det integrerade administrations- och kontrollsystemet</dc:title>
    <dcterms:issued xmlns:dcterms="http://purl.org/dc/terms/">2021-06-08</dcterms:issued>
    <dcterms:modified xmlns:dcterms="http://purl.org/dc/terms/">2021-06-08</dcterms:modified>
  </skos:ConceptScheme>
  <skos:Concept xmlns:skos="http://www.w3.org/2004/02/skos/core#" rdf:about="http://inspire.ec.europa.eu/metadata-codelist/IACSData/lpis">
    <skos:prefLabel xml:lang="sv">LPIS</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Rumsliga datamängder som innehåller avgränsningar av referensskiften, typer av jordbruksområden och stabila arealer med ekologiskt fokus.</skos:scopeNote>
    <skos:inScheme rdf:resource="http://inspire.ec.europa.eu/metadata-codelist/IACSData" />
  </skos:Concept>
  <skos:Concept xmlns:skos="http://www.w3.org/2004/02/skos/core#" rdf:about="http://inspire.ec.europa.eu/metadata-codelist/IACSData/gsaa">
    <skos:prefLabel xml:lang="sv">GEOSPATIALA STÖDSYSTEMET</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Avgränsning av jordbruksskiften med odlade grödor eller odlingsgrupper som lämnats in av jordbrukaren ett visst år</skos:scopeNote>
    <skos:inScheme rdf:resource="http://inspire.ec.europa.eu/metadata-codelist/IACSData" />
  </skos:Concept>
  <skos:Concept xmlns:skos="http://www.w3.org/2004/02/skos/core#" rdf:about="http://inspire.ec.europa.eu/metadata-codelist/IACSData/iacs">
    <skos:prefLabel xml:lang="sv">IAKS</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Medlemsstaternas system för vissa betalningar enligt förordning (EU) nr 1307/2013 och förordning (EU) nr 1305/2013</skos:scopeNote>
    <skos:inScheme rdf:resource="http://inspire.ec.europa.eu/metadata-codelist/IACSData" />
  </skos:Concept>
  <skos:Concept xmlns:skos="http://www.w3.org/2004/02/skos/core#" rdf:about="http://inspire.ec.europa.eu/metadata-codelist/IACSData/referenceParcel">
    <skos:prefLabel xml:lang="sv">ReferensParcel</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Grundläggande rumslig enhet för administration och geografisk lokalisering av jordbruksskiften.Får innehålla ett eller flera deklarerade jordbruksskiften i IACS och får odlas av en eller flera jordbrukare</skos:scopeNote>
    <skos:inScheme rdf:resource="http://inspire.ec.europa.eu/metadata-codelist/IACSData" />
  </skos:Concept>
  <skos:Concept xmlns:skos="http://www.w3.org/2004/02/skos/core#" rdf:about="http://inspire.ec.europa.eu/metadata-codelist/IACSData/agriculturalArea">
    <skos:prefLabel xml:lang="sv">Jordbruksareal</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Arealer som tas av dessa typer av marktäcke, eller deras subtyper (snävare kategorier) som omfattar särskilda landskapselement och/eller träd som ingår i dessa områden.</skos:scopeNote>
    <skos:inScheme rdf:resource="http://inspire.ec.europa.eu/metadata-codelist/IACSData" />
  </skos:Concept>
  <skos:Concept xmlns:skos="http://www.w3.org/2004/02/skos/core#" rdf:about="http://inspire.ec.europa.eu/metadata-codelist/IACSData/ecologicalFocusArea">
    <skos:prefLabel xml:lang="sv">Areal med ekologiskt fokus</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Områden med gynnsam inverkan på miljön och klimatet</skos:scopeNote>
    <skos:inScheme rdf:resource="http://inspire.ec.europa.eu/metadata-codelist/IACSData" />
  </skos:Concept>
</rdf:RDF>